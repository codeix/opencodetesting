# Copy this file to bootstrap.config and fill in the values, to skip the
# interactive prompts in bootstrap.sh. See PLAN.md section 5.1.
#
# Never put the test password in here — bootstrap.sh asks for it separately
# and stores it only in .tools/secrets.env (see PLAN.md section 6).

BASE_URL=https://example.test.app
LOGIN_REQUIRED=y
TEST_USER=testuser

# Address of the separate Ollama model server (Devstral Small 2 + Ministral-3:3b).
# See PLAN.md section 7.
MODEL_SERVER_URL=http://sriolo-desktop.local:11434
